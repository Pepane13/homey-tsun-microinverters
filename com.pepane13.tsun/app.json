  "flow": {
    "triggers": [
      {
        "id": "panel_underperforming",
        "title": {
          "en": "A panel is underperforming",
          "fr": "Un panneau est sous-performant"
        },
        "hint": {
          "en": "Triggered once per episode, after the minimum duration. In adaptive mode the deviation is measured against the panel's usual production at that time.",
          "fr": "Déclenché une fois par épisode, après la durée minimale. En mode adaptatif, l'écart est mesuré par rapport à la production habituelle du panneau à cette heure."
        },
        "tokens": [
          {
            "name": "panel",
            "type": "number",
            "title": {
              "en": "Panel",
              "fr": "Panneau"
            },
            "example": 3
          },
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Panel power (W)",
              "fr": "Puissance du panneau (W)"
            },
            "example": 250
          },
          {
            "name": "expected",
            "type": "number",
            "title": {
              "en": "Expected power (W)",
              "fr": "Puissance attendue (W)"
            },
            "example": 300
          },
          {
            "name": "average",
            "type": "number",
            "title": {
              "en": "Others average (W)",
              "fr": "Moyenne des autres (W)"
            },
            "example": 350
          },
          {
            "name": "deviation",
            "type": "number",
            "title": {
              "en": "Deviation (%)",
              "fr": "Écart (%)"
            },
            "example": -28.6
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mx3000d"
          }
        ]
      },
      {
        "id": "panel_recovered",
        "title": {
          "en": "A panel is back to normal",
          "fr": "Un panneau est revenu à la normale"
        },
        "tokens": [
          {
            "name": "panel",
            "type": "number",
            "title": {
              "en": "Panel",
              "fr": "Panneau"
            },
            "example": 3
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mx3000d"
          }
        ]
      },
      {
        "id": "status_changed",
        "title": {
          "en": "The inverter status changed",
          "fr": "Le statut de l'onduleur a changé"
        },
        "tokens": [
          {
            "name": "status",
            "type": "string",
            "title": {
              "en": "Status",
              "fr": "Statut"
            },
            "example": "Normal"
          },
          {
            "name": "code",
            "type": "number",
            "title": {
              "en": "Status code",
              "fr": "Code statut"
            },
            "example": 1
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mx3000d"
          }
        ]
      },
      {
        "id": "panel_not_producing",
        "title": {
          "en": "A panel is not producing",
          "fr": "Un panneau ne produit pas"
        },
        "hint": {
          "en": "The panel stays below 5 % of the others for the minimum duration set in the device settings.",
          "fr": "Le panneau reste sous 5 % des autres pendant la durée minimale réglée dans l'appareil."
        },
        "tokens": [
          {
            "name": "panel",
            "type": "number",
            "title": {
              "en": "Panel",
              "fr": "Panneau"
            },
            "example": 3
          },
          {
            "name": "average",
            "type": "number",
            "title": {
              "en": "Others average (W)",
              "fr": "Moyenne des autres (W)"
            },
            "example": 350
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mx3000d"
          }
        ]
      },
      {
        "id": "comm_lost",
        "title": {
          "en": "Communication with the inverter was lost",
          "fr": "La communication avec l'onduleur est perdue"
        },
        "hint": {
          "en": "The inverter was producing and has been unreachable for the delay set in the device settings.",
          "fr": "L'onduleur produisait et reste injoignable depuis le délai réglé dans l'appareil."
        },
        "tokens": [
          {
            "name": "minutes",
            "type": "number",
            "title": {
              "en": "Minutes",
              "fr": "Minutes"
            },
            "example": 10
          },
          {
            "name": "cause",
            "type": "string",
            "title": {
              "en": "Probable cause",
              "fr": "Cause probable"
            },
            "example": "Wi-Fi"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=mx3000d"
          }
        ]
      },
      {
