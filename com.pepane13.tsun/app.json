      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection",
            "fr": "Connexion"
          },
          "children": [
            {
              "id": "host",
              "type": "text",
              "label": {
                "en": "Logger IP address",
                "fr": "Adresse IP du logger"
              },
              "value": ""
            },
            {
              "id": "logger_sn",
              "type": "text",
              "label": {
                "en": "Logger serial number",
                "fr": "Numéro de série du logger"
              },
              "hint": {
                "en": "10-digit 'Device serial number' on the logger's label or web page (not the inverter serial number).",
                "fr": "« Device serial number » à 10 chiffres, sur l'étiquette ou la page web du logger (pas le numéro de l'onduleur)."
              },
              "value": ""
            },
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Polling interval",
                "fr": "Intervalle d'interrogation"
              },
              "value": 30,
              "min": 10,
              "max": 600,
              "units": {
                "en": "s",
                "fr": "s"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Panel monitoring",
            "fr": "Surveillance des panneaux"
          },
          "children": [
            {
              "id": "underperf_mode",
              "type": "dropdown",
              "label": {
                "en": "Detection mode",
                "fr": "Mode de détection"
              },
              "hint": {
                "en": "Adaptive: each panel is compared with its own usual production at that time of day (learned automatically, so recurring shadows are not reported; alerts start once a time slot has been learned on 3 days). Simple: each panel is compared with the average of the others.",
                "fr": "Adaptatif : chaque panneau est comparé à sa propre production habituelle à cette heure (apprise automatiquement, les ombrages récurrents ne sont donc pas signalés ; alertes dès qu'une tranche horaire est apprise sur 3 jours). Simple : chaque panneau est comparé à la moyenne des autres."
              },
              "value": "adaptive",
              "values": [
                {
                  "id": "adaptive",
                  "label": {
                    "en": "Adaptive (learned)",
                    "fr": "Adaptatif (appris)"
                  }
                },
                {
                  "id": "simple",
                  "label": {
                    "en": "Simple (average of the others)",
                    "fr": "Simple (moyenne des autres)"
                  }
                }
              ]
            },
            {
              "id": "underperf_threshold",
              "type": "number",
              "label": {
                "en": "Underperformance threshold",
                "fr": "Seuil de sous-performance"
              },
              "hint": {
                "en": "A panel is underperforming when it produces this much less than expected: its usual production at that time (adaptive mode) or the average of the others (simple mode).",
                "fr": "Un panneau est sous-performant quand il produit ce pourcentage de moins que prévu : sa production habituelle à cette heure (mode adaptatif) ou la moyenne des autres (mode simple)."
              },
              "value": 15,
              "min": 5,
              "max": 60,
              "units": {
                "en": "%",
                "fr": "%"
              }
            },
            {
              "id": "underperf_delay",
              "type": "number",
              "label": {
                "en": "Minimum duration",
                "fr": "Durée minimale"
              },
              "hint": {
                "en": "The gap must last this long before the Flow is triggered (filters passing shadows).",
                "fr": "L'écart doit durer ce temps avant de déclencher le Flow (filtre les ombres passagères)."
              },
              "value": 15,
              "min": 1,
              "max": 240,
              "units": {
                "en": "min",
                "fr": "min"
              }
            },
            {
              "id": "underperf_min_power",
              "type": "number",
              "label": {
                "en": "Minimum average power",
                "fr": "Puissance moyenne minimale"
              },
              "hint": {
                "en": "No check below this average panel power (dawn, dusk, heavy clouds).",
                "fr": "Pas de contrôle sous cette puissance moyenne par panneau (aube, crépuscule, ciel très couvert)."
              },
              "value": 80,
              "min": 10,
              "max": 400,
              "units": {
                "en": "W",
                "fr": "W"
              }
            },
            {
              "id": "daily_threshold",
              "type": "number",
              "label": {
                "en": "Daily degradation threshold",
                "fr": "Seuil de dégradation journalière"
              },
              "hint": {
                "en": "Adaptive mode: at midnight, a panel whose share of the daily yield is this much below its usual share is reported (dirt, new shadow, ageing). Starts after 7 learned days.",
                "fr": "Mode adaptatif : à minuit, un panneau dont la part de la production du jour est inférieure de ce pourcentage à sa part habituelle est signalé (encrassement, nouvel ombrage, vieillissement). Actif après 7 jours d'apprentissage."
              },
              "value": 10,
              "min": 3,
              "max": 50,
              "units": {
                "en": "%",
                "fr": "%"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Advanced",
            "fr": "Avancé"
          },
          "children": [
            {
              "id": "temp_offset",
              "type": "number",
              "label": {
                "en": "Temperature offset",
                "fr": "Décalage de température"
              },
              "hint": {
                "en": "Value subtracted from the raw temperature register (40 per TSUN documentation).",
                "fr": "Valeur soustraite au registre brut de température (40 selon la table TSUN)."
              },
              "value": 40,
              "min": 0,
              "max": 100
            },
            {
              "id": "inverter_sn",
              "type": "label",
              "label": {
                "en": "Inverter serial number",
                "fr": "Numéro de série onduleur"
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Diagnostics and alerts",
            "fr": "Diagnostic et alertes"
          },
          "children": [
            {
              "id": "comm_alert_delay",
              "type": "number",
              "label": {
                "en": "Communication loss alert after",
                "fr": "Alerte perte de communication après"
              },
              "hint": {
                "en": "Alert when the inverter stays unreachable this long while it was producing (night standby is ignored).",
                "fr": "Alerte si l'onduleur reste injoignable ce temps alors qu'il produisait (la veille de nuit est ignorée)."
              },
              "value": 10,
              "min": 1,
              "max": 180,
              "units": {
                "en": "min",
                "fr": "min"
              }
            },
            {
              "id": "voltage_max",
              "type": "number",
              "label": {
                "en": "Maximum grid voltage",
                "fr": "Tension réseau maximale"
              },
              "hint": {
                "en": "Above this value a warning is logged (EN 50160: 253 V). Overvoltage makes inverters disconnect.",
                "fr": "Au-delà, un avertissement est journalisé (EN 50160 : 253 V). La surtension provoque des décrochages de l'onduleur."
              },
              "value": 253,
              "min": 230,
              "max": 270,
              "units": {
                "en": "V",
                "fr": "V"
              }
            },
            {
              "id": "voltage_min",
              "type": "number",
              "label": {
                "en": "Minimum grid voltage",
                "fr": "Tension réseau minimale"
              },
              "value": 207,
              "min": 180,
              "max": 230,
              "units": {
                "en": "V",
                "fr": "V"
              }
            },
            {
              "id": "temp_alert",
              "type": "number",
              "label": {
                "en": "Inverter temperature alert",
                "fr": "Alerte température onduleur"
              },
              "value": 90,
              "min": 50,
              "max": 110,
              "units": {
                "en": "°C",
                "fr": "°C"
              }
            }
          ]
        }
      ]
    }
  ],
