  "flow": {
    "triggers": [
      {
        "id": "panel_underperforming",
        "title": {
          "en": "A panel is underperforming",
          "fr": "Un panneau est sous-performant"
        },
        "hint": {
          "en": "Triggered once per episode, after the minimum duration. In adaptive mode the deviation is measured against the panel's usual production at that time.",
