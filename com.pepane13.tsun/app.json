      "pair": [
        {
          "id": "configure"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection",
            "fr": "Connexion"
          },
          "children": [
            {
              "id": "host",
              "type": "text",
              "label": {
                "en": "Logger IP address",
                "fr": "Adresse IP du logger"
              },
              "value": ""
            },
            {
              "id": "logger_sn",
              "type": "text",
              "label": {
                "en": "Logger serial number",
                "fr": "Numéro de série du logger"
              },
              "hint": {
                "en": "10-digit 'Device serial number' on the logger's label or web page (not the inverter serial number).",
                "fr": "« Device serial number » à 10 chiffres, sur l'étiquette ou la page web du logger (pas le numéro de l'onduleur)."
              },
              "value": ""
            },
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Polling interval",
                "fr": "Intervalle d'interrogation"
              },
              "value": 30,
              "min": 10,
              "max": 600,
              "units": {
                "en": "s",
                "fr": "s"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Panel monitoring",
            "fr": "Surveillance des panneaux"
          },
          "children": [
            {
              "id": "underperf_mode",
              "type": "dropdown",
              "label": {
                "en": "Detection mode",
                "fr": "Mode de détection"
              },
              "hint": {
                "en": "Adaptive: learned automatically. Each evening, each panel must have reached its usual best share of production at least once during the day; recurring and seasonal shadows are therefore never reported (alerts after 5 sunny days of learning). Simple: each panel is compared in real time with the average of the others.",
                "fr": "Adaptatif : appris automatiquement. Chaque soir, chaque panneau doit avoir atteint au moins une fois dans la journée sa meilleure part habituelle de production ; les ombres récurrentes et saisonnières ne sont donc jamais signalées (alertes après 5 jours de soleil d'apprentissage). Simple : chaque panneau est comparé en temps réel à la moyenne des autres."
              },
              "value": "adaptive",
              "values": [
                {
                  "id": "adaptive",
                  "label": {
                    "en": "Adaptive (learned)",
                    "fr": "Adaptatif (appris)"
                  }
                },
                {
                  "id": "simple",
                  "label": {
                    "en": "Simple (average of the others)",
                    "fr": "Simple (moyenne des autres)"
                  }
                }
              ]
            },
            {
              "id": "underperf_threshold",
              "type": "number",
              "label": {
                "en": "Underperformance threshold",
                "fr": "Seuil de sous-performance"
              },
              "hint": {
                "en": "Real-time check: a panel is underperforming when it produces this much less than expected: its usual production at that time (adaptive mode, Flow cards only, no notification) or the average of the others (simple mode, with notification).",
                "fr": "Contrôle en temps réel : un panneau est sous-performant quand il produit ce pourcentage de moins que prévu : sa production habituelle à cette heure (mode adaptatif, cartes Flow seulement, sans notification) ou la moyenne des autres (mode simple, avec notification)."
              },
              "value": 15,
              "min": 5,
              "max": 60,
              "units": {
                "en": "%",
                "fr": "%"
              }
            },
            {
              "id": "underperf_delay",
              "type": "number",
              "label": {
                "en": "Minimum duration",
                "fr": "Durée minimale"
              },
              "hint": {
                "en": "The gap must last this long before the Flow is triggered (filters passing shadows).",
                "fr": "L'écart doit durer ce temps avant de déclencher le Flow (filtre les ombres passagères)."
              },
              "value": 30,
              "min": 1,
              "max": 240,
              "units": {
                "en": "min",
                "fr": "min"
              }
            },
            {
              "id": "underperf_min_power",
              "type": "number",
              "label": {
                "en": "Minimum average power",
                "fr": "Puissance moyenne minimale"
              },
              "hint": {
                "en": "No check below this average panel power (dawn, dusk, heavy clouds).",
                "fr": "Pas de contrôle sous cette puissance moyenne par panneau (aube, crépuscule, ciel très couvert)."
              },
              "value": 80,
              "min": 10,
              "max": 400,
              "units": {
                "en": "W",
                "fr": "W"
              }
            },
            {
              "id": "daily_threshold",
              "type": "number",
              "label": {
                "en": "Day verdict threshold",
                "fr": "Seuil du bilan du soir"
              },
              "hint": {
                "en": "Adaptive mode: a panel whose best share of the day is this much below its usual best share is reported in the evening (dirt, cable, diode, ageing). Minimum value: it widens by itself for a naturally irregular panel.",
                "fr": "Mode adaptatif : un panneau dont la meilleure part du jour est inférieure de ce pourcentage à sa meilleure part habituelle est signalé le soir (encrassement, câble, diode, vieillissement). Valeur minimale : elle s'élargit toute seule pour un panneau naturellement irrégulier."
              },
              "value": 10,
              "min": 3,
              "max": 50,
              "units": {
                "en": "%",
                "fr": "%"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Production forecast",
            "fr": "Prévision de production"
          },
          "children": [
            {
              "id": "forecast_enabled",
              "type": "checkbox",
              "label": {
                "en": "Enable the forecast",
                "fr": "Activer la prévision"
              },
              "hint": {
                "en": "Hourly weather forecast of the sunlight on your panels (Open-Meteo, free, no account), calibrated automatically on what your installation actually produces. The Homey location, rounded to about 1 km, is sent to api.open-meteo.com once an hour.",
                "fr": "Prévision météo horaire de l'ensoleillement de vos panneaux (Open-Meteo, gratuit, sans compte), calibrée automatiquement sur ce que produit réellement votre installation. La position du Homey, arrondie à environ 1 km, est envoyée à api.open-meteo.com une fois par heure."
              },
              "value": false
            },
            {
              "id": "forecast_tilt",
              "type": "number",
              "label": {
                "en": "Panel tilt",
                "fr": "Inclinaison des panneaux"
              },
              "hint": {
                "en": "0° = flat, 90° = vertical. A typical tiled roof is 25-35°.",
                "fr": "0° = à plat, 90° = vertical. Un toit en tuiles courant fait 25 à 35°."
              },
              "value": 30,
              "min": 0,
              "max": 90,
              "units": {
                "en": "°",
                "fr": "°"
              }
            },
            {
              "id": "forecast_azimuth",
              "type": "number",
              "label": {
                "en": "Panel orientation",
                "fr": "Orientation des panneaux"
              },
              "hint": {
                "en": "Compass bearing the panels face: 90 = east, 135 = south-east, 180 = south, 225 = south-west, 270 = west. Changing the tilt, orientation or peak power restarts the calibration.",
                "fr": "Direction vers laquelle les panneaux sont tournés : 90 = est, 135 = sud-est, 180 = sud, 225 = sud-ouest, 270 = ouest. Changer l'inclinaison, l'orientation ou la puissance crête relance le calibrage."
              },
              "value": 180,
              "min": 0,
              "max": 360,
              "units": {
                "en": "°",
                "fr": "°"
              }
            },
            {
              "id": "forecast_peak",
              "type": "number",
              "label": {
                "en": "Peak power of the panels",
                "fr": "Puissance crête des panneaux"
              },
              "hint": {
                "en": "Total of the panels (e.g. 6 × 425 Wp = 2550). 0 = use the inverter rated power. Only sets the starting point: the calibration corrects it after a few sunny days.",
                "fr": "Total des panneaux (ex. 6 × 425 Wc = 2550). 0 = puissance nominale de l'onduleur. Ne sert que de point de départ : le calibrage le corrige après quelques jours de soleil."
              },
              "value": 0,
              "min": 0,
              "max": 20000,
              "units": {
                "en": "Wp",
                "fr": "Wc"
              }
            },
            {
              "id": "forecast_model",
              "type": "dropdown",
              "label": {
                "en": "Weather model",
                "fr": "Modèle météo"
              },
              "hint": {
                "en": "Best match: Open-Meteo picks the best models for your location. Météo-France (AROME/ARPEGE) is the most precise in France.",
                "fr": "Meilleur choix : Open-Meteo combine les meilleurs modèles pour votre position. Météo-France (AROME/ARPEGE) est le plus précis en France."
              },
              "value": "best_match",
              "values": [
                {
                  "id": "best_match",
                  "label": {
                    "en": "Best match (recommended)",
                    "fr": "Meilleur choix (recommandé)"
                  }
                },
                {
                  "id": "meteofrance_seamless",
                  "label": {
                    "en": "Météo-France",
                    "fr": "Météo-France"
                  }
                },
                {
                  "id": "icon_seamless",
                  "label": {
                    "en": "DWD ICON (Germany)",
                    "fr": "DWD ICON (Allemagne)"
                  }
                },
                {
                  "id": "ecmwf_ifs025",
                  "label": {
                    "en": "ECMWF",
                    "fr": "ECMWF"
                  }
                },
                {
                  "id": "gfs_seamless",
                  "label": {
                    "en": "NOAA GFS",
                    "fr": "NOAA GFS"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Advanced",
            "fr": "Avancé"
          },
          "children": [
            {
              "id": "temp_offset",
              "type": "number",
              "label": {
                "en": "Temperature offset",
                "fr": "Décalage de température"
              },
              "hint": {
                "en": "Value subtracted from the raw temperature register (40 per TSUN documentation).",
                "fr": "Valeur soustraite au registre brut de température (40 selon la table TSUN)."
              },
              "value": 40,
              "min": 0,
              "max": 100
            },
            {
              "id": "inverter_sn",
              "type": "label",
              "label": {
                "en": "Inverter serial number",
                "fr": "Numéro de série onduleur"
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Diagnostics and alerts",
            "fr": "Diagnostic et alertes"
          },
          "children": [
            {
              "id": "comm_alert_delay",
              "type": "number",
              "label": {
                "en": "Communication loss alert after",
                "fr": "Alerte perte de communication après"
              },
              "hint": {
                "en": "Alert when the inverter stays unreachable this long while it was producing (night standby is ignored).",
                "fr": "Alerte si l'onduleur reste injoignable ce temps alors qu'il produisait (la veille de nuit est ignorée)."
              },
              "value": 10,
              "min": 1,
              "max": 180,
              "units": {
                "en": "min",
                "fr": "min"
              }
            },
            {
              "id": "voltage_max",
              "type": "number",
              "label": {
                "en": "Maximum grid voltage",
                "fr": "Tension réseau maximale"
              },
              "hint": {
                "en": "Above this value a warning is logged (EN 50160: 253 V). Overvoltage makes inverters disconnect.",
                "fr": "Au-delà, un avertissement est journalisé (EN 50160 : 253 V). La surtension provoque des décrochages de l'onduleur."
              },
              "value": 253,
              "min": 230,
              "max": 270,
              "units": {
                "en": "V",
                "fr": "V"
              }
            },
            {
              "id": "voltage_min",
              "type": "number",
              "label": {
                "en": "Minimum grid voltage",
                "fr": "Tension réseau minimale"
              },
              "value": 207,
              "min": 180,
              "max": 230,
              "units": {
                "en": "V",
                "fr": "V"
              }
            },
            {
              "id": "temp_alert",
              "type": "number",
              "label": {
                "en": "Inverter temperature alert",
                "fr": "Alerte température onduleur"
              },
              "value": 90,
              "min": 50,
              "max": 110,
              "units": {
                "en": "°C",
                "fr": "°C"
              }
            }
          ]
        }
      ]
    }
  ],
